$C = "../Common.ui";

// Animal Breeding Configuration Panel
// Layout: Left column (presets + settings) | Right column (animal table)

Group {
  LayoutMode: Center;

  $C.@Container #mainPanel {
    Anchor: (Width: 1600, Height: 960);

    #Title {
      $C.@Title #titleLabel {
        @Text = "ANIMAL BREEDING CONFIGURATION";
      }
    }

    #Content {
      LayoutMode: Left;
      Padding: (Full: 16);

      // ========== LEFT COLUMN - Preset List + Settings ==========
      Group #leftColumn {
        LayoutMode: Top;
        Anchor: (Width: 400);
        Padding: (Right: 16);

        // Preset search
        Group {
          LayoutMode: Left;
          Anchor: (Height: 36, Bottom: 8);

          $C.@TextField #presetSearch {
            FlexWeight: 1;
            Anchor: (Height: 36, Right: 4);
            PlaceholderText: "Search presets...";
          }
          $C.@SecondaryTextButton #presetSearchBtn {
            @Anchor = (Width: 90, Height: 36);
            Text: "GO";
          }
        }

        // Preset list container (paginated)
        Group #presetListContainer {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: $C.@InputBoxBackground;
          Padding: (Full: 6);

          Group #presetList {
            LayoutMode: Top;
            FlexWeight: 1;

            TextButton #preset0 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset1 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset2 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset3 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset4 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset5 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset6 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
            TextButton #preset7 { Text: ""; Anchor: (Height: 32, Bottom: 4); Style: $C.@SecondaryTextButtonStyle; }
          }

          // Add preset button
          $C.@SecondaryTextButton #addPresetBtn {
            @Anchor = (Top: 8, Height: 36);
            Text: "+ ADD PRESET";
          }

          // Pagination controls
          Group #presetPagination {
            LayoutMode: Left;
            Anchor: (Top: 8, Height: 28);

            $C.@SecondaryTextButton #presetPrevBtn {
              @Anchor = (Width: 36, Height: 28);
              Text: "<";
            }
            Label #presetPageLabel {
              Text: "1/1";
              Style: (FontSize: 12, TextColor: #888888, Alignment: Center);
              FlexWeight: 1;
            }
            $C.@SecondaryTextButton #presetNextBtn {
              @Anchor = (Width: 36, Height: 28);
              Text: ">";
            }
          }
        }

        // Preset settings section
        Group #presetSettingsPanel {
          LayoutMode: Top;
          Anchor: (Top: 12);
          Background: $C.@InputBoxBackground;
          Padding: (Full: 12);

          Label {
            Text: "PRESET SETTINGS";
            Style: (FontSize: 14, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Height: 24, Bottom: 4);
          }

          Label {
            Text: "Preset Name";
            Style: (FontSize: 12, TextColor: #888888);
            Anchor: (Bottom: 2);
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 30, Bottom: 8);

            $C.@TextField #presetRenameInput {
              FlexWeight: 1;
              Anchor: (Height: 30, Right: 4);
            }
            $C.@SecondaryTextButton #renamePresetBtn {
              @Anchor = (Width: 140, Height: 30);
              Text: "RENAME";
            }
          }

          // Growth enabled toggle
          Group {
            LayoutMode: Left;
            Anchor: (Height: 36, Bottom: 6);

            Label {
              Text: "Baby Growth";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@SecondaryTextButton #growthToggleBtn {
              @Anchor = (Width: 80, Height: 30);
              Text: "ON";
            }
          }

          // Default growth time
          Group {
            LayoutMode: Left;
            Anchor: (Height: 36, Bottom: 6);

            Label {
              Text: "Growth Time (min)";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@TextField #growthTimeInput {
              Anchor: (Width: 70, Height: 30);
            }
          }

          // Default cooldown
          Group {
            LayoutMode: Left;
            Anchor: (Height: 36);

            Label {
              Text: "Breed Cooldown (min)";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@TextField #cooldownInput {
              Anchor: (Width: 70, Height: 30);
            }
          }
        }

        // Hidden action fields for presets
        $C.@TextField #presetAction0 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction1 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction2 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction3 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction4 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction5 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction6 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #presetAction7 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionPresetPrev { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionPresetNext { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionAddPreset { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionToggleGrowth { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSearchPresets { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionRenamePreset { Anchor: (Width: 0, Height: 0); }
      }

      // ========== RIGHT COLUMN - Animal Table ==========
      Group #rightColumn {
        LayoutMode: Top;
        FlexWeight: 1;

        // Animal search
        Group {
          LayoutMode: Left;
          Anchor: (Height: 36, Bottom: 8);

          $C.@TextField #animalSearch {
            FlexWeight: 1;
            Anchor: (Height: 36, Right: 4);
            PlaceholderText: "Search animals...";
          }
          $C.@SecondaryTextButton #animalSearchBtn {
            @Anchor = (Width: 90, Height: 36);
            Text: "GO";
          }
        }

        // Table container
        Group #animalTableContainer {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: $C.@InputBoxBackground;
          Padding: (Horizontal: 8, Vertical: 6);

          // Table header
          Group #tableHeader {
            LayoutMode: Left;
            Anchor: (Height: 22, Bottom: 4);

            Label { Anchor: (Width: 70); Text: ""; Style: (FontSize: 11, TextColor: #888888); }
            Label { Anchor: (Width: 84); Text: "BREED"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
            Label { Anchor: (Width: 84); Text: "TAME"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
            Label { Anchor: (Width: 84); Text: "COOLDOWN"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
            Label { Anchor: (Width: 84); Text: "GROWTH"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
            Label { FlexWeight: 1; Text: "FOODS"; Style: (FontSize: 11, TextColor: #888888); Padding: (Left: 4); }
          }

          // Row 0
          Group #row0 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row0Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row0Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row0Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row0TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row0Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row0Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row0Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 1
          Group #row1 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row1Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row1Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row1Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row1TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row1Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row1Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row1Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 2
          Group #row2 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row2Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row2Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row2Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row2TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row2Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row2Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row2Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 3
          Group #row3 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row3Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row3Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row3Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row3TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row3Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row3Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row3Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 4
          Group #row4 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row4Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row4Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row4Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row4TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row4Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row4Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row4Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 5
          Group #row5 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row5Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row5Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row5Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row5TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row5Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row5Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row5Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 6
          Group #row6 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row6Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row6Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row6Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row6TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row6Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row6Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row6Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 7
          Group #row7 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row7Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row7Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row7Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row7TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row7Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row7Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row7Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 8
          Group #row8 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row8Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row8Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row8Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row8TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row8Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row8Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row8Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Row 9
          Group #row9 {
            LayoutMode: Left;
            Anchor: (Height: 68, Bottom: 2);
            Group {
              LayoutMode: Top;
              Anchor: (Width: 70, Right: 4);
              Label #row9Name { Text: ""; Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #dddddd, Alignment: Center); }
              Group #row9Icon { Anchor: (Height: 48); }
            }
            $C.@SecondaryTextButton #row9Toggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@SecondaryTextButton #row9TameToggle { @Anchor = (Width: 80, Height: 34, Right: 4); Text: ""; }
            $C.@TextField #row9Cooldown { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row9Growth { Anchor: (Width: 80, Height: 34, Right: 4); }
            $C.@TextField #row9Foods { FlexWeight: 1; Anchor: (Height: 34); }
          }

          // Spacer
          Group { FlexWeight: 1; }

          // Animal pagination controls
          Group #animalPagination {
            LayoutMode: Center;
            Anchor: (Height: 36, Top: 6);

            Group {
              LayoutMode: Left;
              Anchor: (Width: 200, Height: 28);

              $C.@SecondaryTextButton #animalPrevBtn {
                @Anchor = (Width: 36, Height: 28);
                Text: "<";
              }
              Label #animalPageLabel {
                Text: "1/1";
                Style: (FontSize: 12, TextColor: #888888, Alignment: Center);
                FlexWeight: 1;
              }
              $C.@SecondaryTextButton #animalNextBtn {
                @Anchor = (Width: 36, Height: 28);
                Text: ">";
              }
            }
          }
        }

        // Save button
        $C.@TextButton #saveBtn {
          @Anchor = (Height: 40, Top: 8);
          Text: "SAVE TO FILE";
        }

        // Hidden action fields for rows and animal actions
        $C.@TextField #rowAction0 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction1 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction2 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction3 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction4 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction5 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction6 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction7 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction8 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowAction9 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction0 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction1 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction2 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction3 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction4 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction5 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction6 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction7 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction8 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #rowTamingAction9 { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionAnimalPrev { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionAnimalNext { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSave { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSearchAnimals { Anchor: (Width: 0, Height: 0); }
      }
    }
  }
}
