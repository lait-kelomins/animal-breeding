$C = "../Common.ui";

// Animal Breeding Configuration Panel
// Layout: Left column (presets + settings) | Right column (animal table)

Group {
  LayoutMode: Center;

  $C.@Container #mainPanel {
    Anchor: (Width: 1600, Height: 960);

    #Title {
      $C.@Title #titleLabel {
        @Text = "ANIMAL BREEDING CONFIGURATION";
      }
    }

    #Content {
      LayoutMode: Left;
      Padding: (Full: 16);

      // ========== LEFT COLUMN - Preset List + Settings ==========
      Group #leftColumn {
        LayoutMode: Top;
        Anchor: (Width: 500);
        Padding: (Right: 16);

        // Preset search
        Group {
          LayoutMode: Left;
          Anchor: (Height: 36, Bottom: 8);

          $C.@TextField #presetSearch {
            FlexWeight: 1;
            Anchor: (Height: 36, Right: 4);
            PlaceholderText: "Search presets...";
          }
          $C.@SecondaryTextButton #presetSearchBtn {
            @Anchor = (Width: 90, Height: 36);
            Text: "GO";
          }
        }

        // Scrollable preset list
        Group #presetList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          FlexWeight: 1;
          Background: $C.@InputBoxBackground;
          Padding: (Full: 6);
        }

        // Add preset button
        $C.@SecondaryTextButton #addPresetBtn {
          @Anchor = (Top: 8, Height: 36);
          Text: "+ ADD PRESET";
        }

        // Preset settings section
        Group #presetSettingsPanel {
          LayoutMode: Top;
          Anchor: (Top: 12, Height: 320);
          Background: $C.@InputBoxBackground;
          Padding: (Full: 16);

          Label {
            Text: "PRESET SETTINGS";
            Style: (FontSize: 14, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Height: 28, Bottom: 8);
          }

          Label {
            Text: "Preset Name";
            Style: (FontSize: 12, TextColor: #888888);
            Anchor: (Bottom: 4);
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 34, Bottom: 16);

            $C.@TextField #presetRenameInput {
              FlexWeight: 1;
              Anchor: (Height: 34, Right: 4);
            }
            $C.@SecondaryTextButton #renamePresetBtn {
              @Anchor = (Width: 140, Height: 34);
              Text: "RENAME";
            }
          }

          // Growth enabled toggle
          Group {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 10);

            Label {
              Text: "Baby Growth";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@SecondaryTextButton #growthToggleBtn {
              @Anchor = (Width: 90, Height: 34);
              Text: "ON";
            }
          }

          // Default growth time
          Group {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 10);

            Label {
              Text: "Growth Time (min)";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@TextField #growthTimeInput {
              Anchor: (Width: 80, Height: 34);
            }
          }

          // Default cooldown
          Group {
            LayoutMode: Left;
            Anchor: (Height: 40);

            Label {
              Text: "Breed Cooldown (min)";
              Style: (FontSize: 13, TextColor: #cccccc);
              FlexWeight: 1;
            }
            $C.@TextField #cooldownInput {
              Anchor: (Width: 80, Height: 34);
            }
          }
        }

        // Hidden action fields for left column buttons
        $C.@TextField #actionAddPreset { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionToggleGrowth { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSearchPresets { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionRenamePreset { Anchor: (Width: 0, Height: 0); }
      }

      // ========== RIGHT COLUMN - Animal Table ==========
      Group #rightColumn {
        LayoutMode: Top;
        FlexWeight: 1;

        // Animal search
        Group {
          LayoutMode: Left;
          Anchor: (Height: 36, Bottom: 8);

          $C.@TextField #animalSearch {
            FlexWeight: 1;
            Anchor: (Height: 36, Right: 4);
            PlaceholderText: "Search animals...";
          }
          $C.@SecondaryTextButton #animalSearchBtn {
            @Anchor = (Width: 90, Height: 36);
            Text: "GO";
          }
        }

        // Main content area: scroll list (left) + detail panel (right)
        Group #animalContent {
          LayoutMode: Left;
          FlexWeight: 1;

          // Left side: table header + scrollable list
          Group #animalListSide {
            LayoutMode: Top;
            FlexWeight: 1;
            Padding: (Right: 8);

            // Table header
            Group #tableHeader {
              LayoutMode: Left;
              Anchor: (Height: 22, Bottom: 4);
              Padding: (Horizontal: 8);

              Label { Anchor: (Width: 40); Text: ""; Style: (FontSize: 11, TextColor: #888888); }
              Label { FlexWeight: 1; Text: ""; Style: (FontSize: 11, TextColor: #888888); }
              Label { Anchor: (Width: 94); Text: "TAME"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
              Label { Anchor: (Width: 90); Text: "BREED"; Style: (FontSize: 11, TextColor: #888888, Alignment: Center); }
            }

            // Scrollable animal list
            Group #animalRows {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              FlexWeight: 1;
              Background: $C.@InputBoxBackground;
              Padding: (Horizontal: 8, Vertical: 6);
            }
          }

          // Right side: detail panel
          Group #detailPanel {
            LayoutMode: Top;
            Anchor: (Width: 400);
            Background: $C.@InputBoxBackground;
            Padding: (Full: 10);

            Label #detailTitle { Text: "Select an animal"; Style: (FontSize: 13, RenderBold: true, TextColor: #ffaa00); Anchor: (Height: 22, Bottom: 8); }

            Label { Text: "Cooldown (min)"; Style: (FontSize: 12, TextColor: #888888); Anchor: (Height: 18, Bottom: 2); }
            $C.@TextField #detailCooldown { Anchor: (Height: 30, Bottom: 8); }

            Label { Text: "Growth (min)"; Style: (FontSize: 12, TextColor: #888888); Anchor: (Height: 18, Bottom: 2); }
            $C.@TextField #detailGrowth { Anchor: (Height: 30, Bottom: 8); }

            // Food picker
            Label { Text: "FOODS"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00); Anchor: (Height: 18, Bottom: 4, Top: 8); }
            $C.@TextField #foodSearch {
              Anchor: (Height: 28, Bottom: 4);
              PlaceholderText: "Search foods...";
            }
            Group #foodList {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              FlexWeight: 1;
              Background: $C.@InputBoxBackground;
              Padding: (Full: 4);
            }
          }
        }

        // Save button
        $C.@TextButton #saveBtn {
          @Anchor = (Height: 40, Top: 8);
          Text: "SAVE TO FILE";
        }

        // Hidden action fields
        $C.@TextField #actionSave { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSearchAnimals { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionSearchFoods { Anchor: (Width: 0, Height: 0); }
        $C.@TextField #actionDetailChanged { Anchor: (Width: 0, Height: 0); }
      }
    }
  }
}
