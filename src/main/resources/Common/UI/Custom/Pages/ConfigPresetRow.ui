$C = "../Common.ui";

// Preset row for scrollable config panel sidebar
// Appended dynamically via cmd.append("#presetList", "Pages/ConfigPresetRow.ui")

Group {
  LayoutMode: Left;
  Anchor: (Height: 32, Bottom: 4);

  // Clickable preset name button
  TextButton #presetBtn {
    FlexWeight: 1;
    Anchor: (Height: 32);
    Text: "";
    Style: $C.@SecondaryTextButtonStyle;
  }

  // Hidden action field
  $C.@TextField #presetAction { Anchor: (Width: 0, Height: 0); }
}
