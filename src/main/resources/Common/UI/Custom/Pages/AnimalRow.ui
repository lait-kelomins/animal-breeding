$C = "../Common.ui";

// Animal row for scrollable config panel list
// Appended dynamically via cmd.append("#animalRows", "Pages/AnimalRow.ui")
// Layout: [icon 36px] [name button fills] [tame 90px] [breed 90px]

Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 2);

  // Icon
  Group #icon { Anchor: (Width: 36, Height: 36, Right: 4); }

  // Name / select button (fills remaining width)
  TextButton #selectBtn {
    FlexWeight: 1;
    Anchor: (Height: 34, Right: 4);
    Text: "";
    Style: $C.@SecondaryTextButtonStyle;
  }

  // Tame toggle (first)
  $C.@SecondaryTextButton #tameToggle { @Anchor = (Width: 90, Height: 34, Right: 4); Text: "OFF"; }

  // Breed toggle (second)
  $C.@SecondaryTextButton #breedToggle { @Anchor = (Width: 90, Height: 34); Text: "OFF"; }

  // Hidden action fields (one per interactive element)
  $C.@TextField #selectAction { Anchor: (Width: 0, Height: 0); }
  $C.@TextField #breedAction { Anchor: (Width: 0, Height: 0); }
  $C.@TextField #tameAction { Anchor: (Width: 0, Height: 0); }
}
