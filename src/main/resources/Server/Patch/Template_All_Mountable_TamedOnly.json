{
    "$Comment": "Require taming before mounting (if another mod adds mounting)",
    "_BaseAssetPath": "regex:Server/NPC/Roles/_Core/Templates/Template_(?!Animal_Neutral\\b).+\\.json",
    "_priority": 100,
    "InteractionInstruction": {
        "Instructions": [
            {
                "_find": { "Enabled": { "Compute": "IsMountable" } },
                "Instructions": [
                    {
                        "_op": "replace",
                        "_find": {
                            "Sensor": { "Type": "HasInteracted" },
                            "Actions": [{
                                "Type": "Mount",
                                "AnchorX": { "Compute": "MountAnchorX" },
                                "AnchorY": { "Compute": "MountAnchorY" },
                                "AnchorZ": { "Compute": "MountAnchorZ" },
                                "MovementConfig": { "Compute": "MountMovementConfig" }
                            }]
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                { "Type": "Tamed", "Set": true },
                                { "Type": "HasInteracted" }
                            ]
                        },
                        "Actions": [{
                            "Type": "Mount",
                            "AnchorX": { "Compute": "MountAnchorX" },
                            "AnchorY": { "Compute": "MountAnchorY" },
                            "AnchorZ": { "Compute": "MountAnchorZ" },
                            "MovementConfig": { "Compute": "MountMovementConfig" }
                        }]
                    }
                ]
            }
        ]
    }
}
