{
    "$Comment": "Growth alarm for baby animals - modeled after vanilla Harvest_Ready pattern",
    "_BaseAssetPath": "Server/NPC/Roles/_Core/Templates/Template_Animal_Neutral.json",
    "_priority": 95,
    "Parameters": {
        "GrowthTimeout": {
            "Value": ["PT15H", "PT15H"],
            "Description": "Time until baby grows (ISO 8601 game-time, 30x real). Default 30 real min."
        }
    },
    "Instructions": [
        {
            "_op": "add",
            "_index": 0,
            "Continue": true,
            "$Comment": "[HYTAME Growth] Initialize growth alarm for babies",
            "Sensor": {
                "Type": "And",
                "Sensors": [
                    {
                        "Type": "Alarm",
                        "Name": "Growth_Ready",
                        "State": "Unset"
                    },
                    {
                        "Type": "GrowthReady"
                    }
                ]
            },
            "Actions": [
                {
                    "Type": "SetAlarm",
                    "Name": "Growth_Ready",
                    "DurationRange": {
                        "Compute": "GrowthTimeout"
                    }
                }
            ]
        },
        {
            "_op": "add",
            "_index": 1,
            "Continue": true,
            "$Comment": "[HYTAME Growth] Grow when alarm passes",
            "Sensor": {
                "Type": "Alarm",
                "Name": "Growth_Ready",
                "State": "Passed",
                "Clear": true
            },
            "Actions": [
                {
                    "Type": "GrowToNextStage"
                }
            ]
        }
    ]
}
