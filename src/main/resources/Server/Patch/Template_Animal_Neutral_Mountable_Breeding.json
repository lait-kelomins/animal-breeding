{
    "$Comment": "Add breeding to tamed mountable animals with LovedItems",
    "BaseAssetPath": "NPC/Roles/_Core/Templates/Template_Animal_Neutral",
    "InteractionInstruction": {
        "Instructions": [
            {
                "_find": {
                    "Enabled": {
                        "Compute": "IsMountable"
                    }
                },
                "Instructions": [
                    {
                        "_op": "addBefore",
                        "_index": 0,
                        "$Comment": "Breeding: Show prompt when tamed + LovedItems",
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Continue": true,
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Tamed",
                                    "Set": true
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "Type": "HasInteracted"
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": true
                            },
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}