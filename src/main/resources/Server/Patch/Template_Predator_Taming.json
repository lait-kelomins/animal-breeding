{
    "_comment": "Add taming/feeding support to predators",
    "BaseAssetPath": "NPC/Roles/_Core/Templates/Template_Predator",
    "Parameters": {
        "LovedItems": {
            "Value": [
                "Food_Wildmeat_Raw",
                "Food_Fish_Raw"
            ],
            "TypeHint": "String",
            "Description": "Items that can be used to tame/feed this animal"
        }
    },
    "InteractionInstruction": {
        "Enabled": {
            "Compute": "!isEmptyStringArray(LovedItems)"
        },
        "Instructions": [
            {
                "_comment": "Block for predators with LovedItems",
                "Enabled": {
                    "Compute": "!isEmptyStringArray(LovedItems)"
                },
                "Instructions": [
                    {
                        "_comment": "Wild predator = Tame",
                        "Continue": true,
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "IsTameable",
                                    "Set": true
                                },
                                {
                                    "Type": "Not",
                                    "Sensor": {
                                        "Type": "Tamed",
                                        "Set": true
                                    }
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "_comment": "Tamed predator = Feed",
                        "Continue": true,
                        "Sensor": {
                            "Type": "Tamed",
                            "Set": true
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    },
                    {
                        "_comment": "Always clear animation when moving from Alerted or Flee state.",
                        "Actions": [
                            {
                                "Slot": "Status",
                                "Type": "PlayAnimation"
                            },
                            {
                                "Name": "AnimationBlock",
                                "SetTo": false,
                                "Type": "SetFlag"
                            }
                        ],
                        "States": [
                            {
                                "From": [
                                    "Alerted",
                                    "Flee"
                                ],
                                "To": []
                            }
                        ]
                    },
                    {
                        "_comment": "Always clear target and reset instructions when going back to idle.",
                        "Actions": [
                            {
                                "Type": "ReleaseTarget"
                            },
                            {
                                "Type": "ResetInstructions"
                            },
                            {
                                "Slot": "Status",
                                "Type": "PlayAnimation"
                            }
                        ],
                        "States": [
                            {
                                "From": [],
                                "To": [
                                    "Idle"
                                ]
                            }
                        ]
                    },
                    {
                        "_comment": "Clear idle anims",
                        "Actions": [
                            {
                                "Slot": "Status",
                                "Type": "PlayAnimation"
                            }
                        ],
                        "States": [
                            {
                                "From": [
                                    "Idle"
                                ],
                                "To": []
                            }
                        ]
                    }
                ]
            }
        ]
    }
}