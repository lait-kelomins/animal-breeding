{
    "$Comment": "Add breeding to harvestable creatures (if another mod adds harvesting)",
    "_BaseAssetPath": "regex:Server/NPC/Roles/_Core/Templates/Template_(?!Animal_Neutral\\b).+\\.json",
    "_priority": 100,
    "InteractionInstruction": {
        "Instructions": [
            {
                "_find": { "Enabled": { "Compute": "IsHarvestable" } },
                "Instructions": [
                    {
                        "_op": "addBefore",
                        "_index": 0,
                        "$Comment": "Breeding: Tamed + LovedItems + F-key",
                        "Enabled": { "Compute": "!isEmptyStringArray(LovedItems)" },
                        "Continue": true,
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                { "Type": "Alarm", "Name": "Breed_Cooldown", "State": "Unset" },
                                { "Type": "Tamed", "Set": true },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [{ "Type": "ItemInHand", "Items": { "Compute": "LovedItems" } }]
                                },
                                { "Type": "HasInteracted" }
                            ]
                        },
                        "Actions": [
                            { "Type": "SetInteractable", "Interactable": true, "ShowPrompt": true },
                            { "Type": "HyTameFeedInteraction" }
                        ]
                    }
                ]
            }
        ]
    }
}
