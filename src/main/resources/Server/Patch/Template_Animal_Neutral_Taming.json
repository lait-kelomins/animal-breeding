{
    "_comment": "Add taming/feeding to all animals with LovedItems, including harvestable/mountable ones",
    "BaseAssetPath": "NPC/Roles/_Core/Templates/Template_Animal_Neutral",
    "InteractionInstruction": {
        "Enabled": {
            "Compute": "IsHarvestable || IsMountable || !isEmptyStringArray(LovedItems)"
        },
        "Instructions": [
            {
                "_comment": "Block 0: Simple tameable animals (not mountable, not harvestable)",
                "_op": "addBefore",
                "Enabled": {
                    "Compute": "!isEmptyStringArray(LovedItems) && !IsMountable && !IsHarvestable"
                },
                "Instructions": [
                    {
                        "_comment": "Wild animal = Tame",
                        "Continue": true,
                        "Sensor": {
                            "Type": "Not",
                            "Sensor": {
                                "Type": "Tamed",
                                "Set": true
                            }
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "_comment": "Tamed animal = Feed",
                        "Continue": true,
                        "Sensor": {
                            "Type": "Tamed",
                            "Set": true
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    }
                ]
            },
            {
                "_comment": "Block 1: Modify harvestable block - add tame/feed checks BEFORE harvest logic",
                "_find": {
                    "Enabled": {
                        "Compute": "IsHarvestable"
                    }
                },
                "Instructions": [
                    {
                        "_comment": "NEW: Wild harvestable + player has loved item = Tame",
                        "_op": "add",
                        "_index": 0,
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Not",
                                    "Sensor": {
                                        "Type": "Tamed",
                                        "Set": true
                                    }
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "_comment": "NEW: Tamed harvestable + player has loved item = Feed",
                        "_op": "add",
                        "_find": {
                            "Enabled": {
                                "Compute": "IsMountable"
                            }
                        },
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Tamed",
                                    "Set": true
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    }
                ]
            },
            {
                "_comment": "Block 2: Modify mountable block - add tame/feed checks BEFORE mount logic",
                "_find": {
                    "Enabled": {
                        "Compute": "IsMountable"
                    }
                },
                "Instructions": [
                    {
                        "_comment": "NEW: Wild mountable + player has loved item = Tame (STOP to prevent mounting)",
                        "_op": "addBefore",
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Not",
                                    "Sensor": {
                                        "Type": "Tamed",
                                        "Set": true
                                    }
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "_comment": "NEW: Tamed mountable + player has loved item = Feed (STOP to prevent mounting)",
                        "_op": "addAfter",
                        "_index": 0,
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Tamed",
                                    "Set": true
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}