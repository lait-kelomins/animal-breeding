{
    "$Comment": "Add LovedItems following behavior to predators with patience timer for wild wolves",
    "_BaseAssetPath": "Server/NPC/Roles/_Core/Templates/Template_Predator.json",

    "Parameters": {
        "LovedItems": {
            "Value": ["Food_Wildmeat_Raw", "Food_Wildmeat_Cooked", "Food_Fish_Raw"]
        },
        "FriendlyOverrideTimeWithAttractiveItem": {
            "Value": 10,
            "Description": "Duration of friendly attitude after player stops holding LovedItems (seconds)"
        }
    },

    "Instructions": [
        {
            "_op": "add",
            "_index": 0,
            "Continue": true,
            "Enabled": { "Compute": "!isEmptyStringArray(LovedItems)" },
            "$Comment": "[HyTame] Hearts once per detection",
            "Sensor": {
                "Type": "Player",
                "Range": { "Compute": "AlertedRange" },
                "Once": true,
                "Filters": [
                    { "Type": "ItemInHand", "Items": { "Compute": "LovedItems" } }
                ]
            },
            "Actions": [
                { "Type": "SpawnParticles", "Offset": [0, 1, 0], "ParticleSystem": "Hearts" }
            ]
        },
        {
            "_op": "add",
            "_index": 1,
            "Continue": true,
            "Enabled": { "Compute": "!isEmptyStringArray(LovedItems)" },
            "$Comment": "[HyTame] Patience timer init (first encounter): wild predator sees player with food, alarm not yet set → start 10-30s countdown",
            "Sensor": {
                "Type": "And",
                "Sensors": [
                    { "Type": "Not", "Sensor": { "Type": "Tamed", "Set": true } },
                    { "Type": "Alarm", "Name": "HyTame_PatienceUsed", "State": "Unset" },
                    {
                        "Type": "Player",
                        "Range": { "Compute": "AlertedRange" },
                        "Filters": [
                            { "Type": "ItemInHand", "Items": { "Compute": "LovedItems" } }
                        ]
                    }
                ]
            },
            "Actions": [
                { "Type": "TimerStart", "Name": "HyTame_Patience", "StartValueRange": [10, 30], "RestartValueRange": [10, 30] },
                { "Type": "SetAlarm", "Name": "HyTame_PatienceUsed", "DurationRange": ["PT1H", "PT1H"] }
            ]
        },
        {
            "_op": "add",
            "_index": 2,
            "Continue": true,
            "Enabled": { "Compute": "!isEmptyStringArray(LovedItems)" },
            "$Comment": "[HyTame] Patience timer init (cooldown expired): alarm passed after ~2min real time → wolf can be lured again",
            "Sensor": {
                "Type": "And",
                "Sensors": [
                    { "Type": "Not", "Sensor": { "Type": "Tamed", "Set": true } },
                    { "Type": "Alarm", "Name": "HyTame_PatienceUsed", "State": "Passed" },
                    {
                        "Type": "Player",
                        "Range": { "Compute": "AlertedRange" },
                        "Filters": [
                            { "Type": "ItemInHand", "Items": { "Compute": "LovedItems" } }
                        ]
                    }
                ]
            },
            "Actions": [
                { "Type": "TimerStart", "Name": "HyTame_Patience", "StartValueRange": [10, 30], "RestartValueRange": [10, 30] },
                { "Type": "SetAlarm", "Name": "HyTame_PatienceUsed", "DurationRange": ["PT1H", "PT1H"] }
            ]
        },
        {
            "_op": "add",
            "_index": 3,
            "Enabled": { "Compute": "!isEmptyStringArray(LovedItems)" },
            "$Comment": "[HyTame] Wild predator follow while patience timer running. When timer expires, LockOnTarget side-effect targets player for attack. No Continue stops chain during follow.",
            "Sensor": {
                "Type": "And",
                "Sensors": [
                    { "Type": "Not", "Sensor": { "Type": "Tamed", "Set": true } },
                    { "Type": "Timer", "Name": "HyTame_Patience", "State": "Running" },
                    {
                        "Type": "Player",
                        "Range": { "Compute": "AlertedRange" },
                        "LockOnTarget": true,
                        "Filters": [
                            { "Type": "ItemInHand", "Items": { "Compute": "LovedItems" } }
                        ]
                    }
                ]
            },
            "Actions": [
                { "Type": "OverrideAttitude", "Attitude": "Friendly", "Duration": { "Compute": "FriendlyOverrideTimeWithAttractiveItem" } }
            ],
            "HeadMotion": { "Type": "Watch" },
            "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 3.5,
                "StopDistance": 2,
                "RelativeSpeed": 0.7
            }
        }
    ]
}
