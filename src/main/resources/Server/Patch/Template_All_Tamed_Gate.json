{
    "$Comment": "[HYTAME] Suppress player aggression for all tamed animals",
    "_BaseAssetPath": "regex:Server/NPC/Roles/_Core/Templates/Template_.+\\.json",
    "_priority": 90,
    "Instructions": [
        {
            "_op": "add",
            "_index": 0,
            "Continue": true,
            "$Comment": "[HYTAME] Tamed: release stale Friendly targets (player after LovedItems override). Allows the override instruction below to fire.",
            "Sensor": {
                "Type": "And",
                "Sensors": [
                    { "Type": "Tamed", "Set": true },
                    {
                        "Type": "Target",
                        "Filters": [
                            { "Type": "Attitude", "Attitudes": ["Friendly"] }
                        ]
                    }
                ]
            },
            "Actions": [
                { "Type": "ReleaseTarget" }
            ]
        },
        {
            "_op": "add",
            "_index": 1,
            "Continue": true,
            "$Comment": "[HYTAME] Tamed + no target: override player to Friendly. Children nesting prevents LockOnTarget from hijacking prey targets.",
            "Sensor": { "Type": "Tamed", "Set": true },
            "Children": [
                {
                    "Sensor": { "Type": "Not", "Sensor": { "Type": "Target" } },
                    "Children": [
                        {
                            "Sensor": { "Type": "Player", "Range": 30, "LockOnTarget": true },
                            "Actions": [
                                { "Type": "OverrideAttitude", "Attitude": "Friendly", "Duration": 300 },
                                { "Type": "ReleaseTarget" }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
