{
    "_comment": "Add taming/feeding to all animals with LovedItems, including harvestable/mountable ones",
    "BaseAssetPath": "NPC/Roles/_Core/Templates/Template_Animal_Neutral",
    "_op": "replace",
    "_find": "$[InteractionInstruction]",
    "InteractionInstruction": {
        "Instructions": [
            {
                "_comment": "Block 2: Modify mountable block - add tame/feed checks BEFORE mount logic",
                "_find": {
                    "Enabled": {
                        "Compute": "IsMountable"
                    }
                },
                "_op": "addBefore",
                "Enabled": {
                    "Compute": "IsMountable"
                },
                "Instructions": [
                    {
                        "_comment": "Block if already tamed",
                        "Sensor": {
                            "Type": "Tamed",
                            "Set": true
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": false,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "_comment": "NEW: Wild mountable + player has loved item = Tame (STOP to prevent mounting)",
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Not",
                                    "Sensor": {
                                        "Type": "Tamed",
                                        "Set": true
                                    }
                                },
                                {
                                    "Type": "Not",
                                    "Sensor": {
                                        "Type": "Player",
                                        "Range": 5,
                                        "Filters": [
                                            {
                                                "Type": "ItemInHand",
                                                "Items": {
                                                    "Compute": "LovedItems"
                                                }
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    },
                    {
                        "_comment": "NEW: Tamed mountable + player has loved item = Feed (STOP to prevent mounting)",
                        "Enabled": {
                            "Compute": "!isEmptyStringArray(LovedItems)"
                        },
                        "Sensor": {
                            "Type": "And",
                            "Sensors": [
                                {
                                    "Type": "Tamed",
                                    "Set": true
                                },
                                {
                                    "Type": "Player",
                                    "Range": 5,
                                    "Filters": [
                                        {
                                            "Type": "ItemInHand",
                                            "Items": {
                                                "Compute": "LovedItems"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "Actions": [
                            {
                                "Type": "SetInteractable",
                                "Interactable": true,
                                "ShowPrompt": false
                            }
                        ]
                    },
                    {
                        "Sensor": {
                            "Type": "HasInteracted"
                        },
                        "Actions": [
                            {
                                "Type": "HyTameFeedInteraction"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}