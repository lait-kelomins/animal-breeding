$C = "../Common.ui";

// Config Panel UI - Settings dialog for Animal Breeding plugin
// Opens via /breed settings command

Group {
  LayoutMode: Center;

  $C.@Container #dialogPanel {
    Anchor: (Width: 420, Height: 300);

    #Title {
      $C.@Title #titleLabel {
        @Text = "BREEDING SETTINGS";
      }
    }

    #Content {
      Padding: (Vertical: 16, Horizontal: 24);

      // Growth Enabled row (display only, toggle via button)
      Group {
        LayoutMode: Left;
        Background: $C.@InputBoxBackground;
        Padding: (Left: 15, Right: 10);
        Anchor: (Height: 42, Bottom: 8);

        Label {
          Text: "Baby Growth";
          Style: (FontSize: 13, TextColor: #cccccc);
          FlexWeight: 1;
        }

        Label #growthStatus {
          Text: "ON";
          Style: (FontSize: 13, RenderBold: true, TextColor: #88ff88);
          Anchor: (Right: 8);
        }

        $C.@SecondaryTextButton #toggleButton {
          @Anchor = (Width: 60, Height: 28);
          Text: "TOGGLE";
        }
      }

      // Default Growth Time row
      Group {
        LayoutMode: Left;
        Background: $C.@InputBoxBackground;
        Padding: (Left: 15, Right: 10);
        Anchor: (Height: 42, Bottom: 8);

        Label {
          Text: "Default Growth (min)";
          Style: (FontSize: 13, TextColor: #cccccc);
          FlexWeight: 1;
        }

        $C.@TextField #growthTimeInput {
          Anchor: (Width: 80, Height: 30);
        }
      }

      // Default Breed Cooldown row
      Group {
        LayoutMode: Left;
        Background: $C.@InputBoxBackground;
        Padding: (Left: 15, Right: 10);
        Anchor: (Height: 42, Bottom: 8);

        Label {
          Text: "Breed Cooldown (min)";
          Style: (FontSize: 13, TextColor: #cccccc);
          FlexWeight: 1;
        }

        $C.@TextField #cooldownInput {
          Anchor: (Width: 80, Height: 30);
        }
      }

      // Buttons row
      Group {
        LayoutMode: Center;
        Anchor: (Top: 16);

        $C.@SecondaryTextButton #closeButton {
          @Anchor = (Right: 8);
          Text: "CLOSE";
          FlexWeight: 1;
        }

        $C.@TextButton #saveButton {
          Text: "SAVE";
          FlexWeight: 1;
        }
      }

      // Hidden action markers (TextFields so .Value can be read)
      $C.@TextField #actionToggle {
        Anchor: (Width: 0, Height: 0);
      }
      $C.@TextField #actionSave {
        Anchor: (Width: 0, Height: 0);
      }
      $C.@TextField #actionClose {
        Anchor: (Width: 0, Height: 0);
      }
    }
  }
}
